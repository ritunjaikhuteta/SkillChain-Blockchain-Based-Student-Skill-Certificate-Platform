# Root .gitignore for SkillChain Monorepo

# Environment variables & secrets (never commit local environment files)
.env
.env.*
*.env
*.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# File uploads and local storage
backend/uploads/
uploads/

# Operating System
.DS_Store
Thumbs.db

# IDE & Editor files
.idea/
.vscode/
*.iml
*.swp
*.swo

# Backend build artifacts
backend/target/
backend/.mvn/
backend/*.log

# Frontend build artifacts
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
