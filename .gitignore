# Root .gitignore for SkillChain Monorepo

# Environment variables
.env
.env.local
.env.*.local

# Operating System
.DS_Store
Thumbs.db

# IDE & Editor files
.idea/
.vscode/
*.iml
*.swp
*.swo

# Backend build artifacts
backend/target/
backend/.mvn/
backend/*.log

# Frontend build artifacts
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
