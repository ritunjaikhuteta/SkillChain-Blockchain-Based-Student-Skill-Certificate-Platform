# SkillChain Monorepo Environment Variables Example
# Copy this file to .env or set environment variables in your terminal session.
# DO NOT commit real secrets, database passwords, or credentials to version control.

# Backend Server Configuration
PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/skillchain_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here

# JWT Security Configuration
# Must be a cryptographically secure 256-bit+ secret key (hex or base64)
# Generate a new random secret with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_hex_or_base64
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Initial Platform Administrator Provisioning
# The backend bootstraps this account on initial launch with role ADMIN
ADMIN_EMAIL=admin@skillchain.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Object Storage Configuration (AWS S3 / Cloudflare R2 / Supabase Storage / MinIO)
# Leave blank to fallback automatically to local disk storage for development.
# In production on Render/containers, configuring S3 storage is recommended to prevent data loss across restarts.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional custom endpoint (e.g., https://<account_id>.r2.cloudflarestorage.com or http://localhost:9000 for MinIO)
S3_ENDPOINT=

# Local storage directory fallback (used if S3_BUCKET or credentials are not provided)
UPLOAD_DIR=uploads/certificates

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api

